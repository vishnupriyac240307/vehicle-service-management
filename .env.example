# ============================================================================
# Vehicle Service Management System - Oracle Database Configuration
# ============================================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5050
SECRET_KEY=tn-skills-vehicle-management-secret-key-2026

# Oracle Database Connection Details
# Replace with your Oracle Database user credentials and instance details:
ORACLE_USER=c##vehicleservice
ORACLE_PASSWORD=YourPassword123
ORACLE_HOST=localhost
ORACLE_PORT=1521

# Common Oracle Service Names / PDB Names:
# - Oracle Database 23ai Free: FREEPDB1
# - Oracle Database Express Edition (XE 18c/21c): XEPDB1
# - Oracle Database 19c Enterprise: ORCLPDB1 or ORCLCDB
# - Legacy SID (if using SID instead of Service Name): XE or ORCL
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_SID=

# Alternatively, specify a complete Easy Connect or TNS DSN string:
# Example: localhost:1521/FREEPDB1 or localhost:1521/XEPDB1
ORACLE_DSN=

# Optional: Path to Oracle Cloud Wallet directory (if using OCI Autonomous DB)
# ORACLE_WALLET_DIR=/path/to/wallet
# ORACLE_WALLET_PASSWORD=
